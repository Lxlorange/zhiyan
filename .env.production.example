# No domain: keep :80 and visit http://SERVER_PUBLIC_IP
# Domain later: change to your domain, for example a3.example.com
APP_SITE_ADDRESS=:80

POSTGRES_DB=zhiyan_a3
POSTGRES_USER=zhiyan
POSTGRES_PASSWORD=replace-with-a-long-random-password

APP_NAME=zhiyan-a3-api
APP_ENV=production
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://SERVER_PUBLIC_IP

LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://ws-zdgnhxh8fif3r56e.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_SECONDS=180

XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

KNOWLEDGE_UPLOAD_DIR=/app/uploaded_knowledge
KNOWLEDGE_EMBEDDING_PROVIDER=qwen
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v3
KNOWLEDGE_EMBEDDING_DIM=1024
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP=180
KNOWLEDGE_MAX_UPLOAD_MB=100
LOCAL_OCR_ENGINE=tesseract
TESSERACT_CMD=/usr/bin/tesseract
LIBREOFFICE_PATH=/usr/bin/libreoffice
