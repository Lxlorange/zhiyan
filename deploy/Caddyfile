{$APP_DOMAIN} {
    encode gzip zstd

    request_body {
        max_size 350MB
    }

    handle /api/* {
        reverse_proxy backend:18000
    }

    handle /docs* {
        reverse_proxy backend:18000
    }

    handle /redoc* {
        reverse_proxy backend:18000
    }

    handle /openapi.json {
        reverse_proxy backend:18000
    }

    handle {
        reverse_proxy frontend:80
    }
}
